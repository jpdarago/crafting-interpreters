// Functions with side effects and return values.
fun greet(name) {
  print "Hello, " + name + "!";
}

greet("Alice");
greet("Bob");

fun add(a, b) {
  return a + b;
}

print add(2, 3);
print add(10, 20);

fun countdown(n) {
  while (n > 0) {
    print n;
    n = n - 1;
  }
  print "Go!";
}

countdown(3);

fun square(x) {
  return x * x;
}

print square(5);
print square(3);
